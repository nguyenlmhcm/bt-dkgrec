<mxfile host="bt-dkgrec"><diagram name="Hinh 3.1" id="Hinh_3.1"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lan1" value="" style="fontFamily=Times New Roman;fontColor=#1F2328;rounded=1;arcSize=3;html=1;strokeColor=#C9CDD3;strokeWidth=1;fillColor=#F6F7F8;" vertex="1" parent="1"><mxGeometry x="-12" y="98" width="836" height="122" as="geometry"/></mxCell><mxCell id="lan2" value="" style="fontFamily=Times New Roman;fontColor=#1F2328;rounded=1;arcSize=3;html=1;strokeColor=#C9CDD3;strokeWidth=1;fillColor=#F6F7F8;" vertex="1" parent="1"><mxGeometry x="-12" y="328" width="836" height="122" as="geometry"/></mxCell><mxCell id="n3" value="CẬP NHẬT ĐỒ THỊ CẬN THỜI GIAN THỰC" style="fontFamily=Times New Roman;fontColor=#1F2328;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#5B6068;fontStyle=1;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="-10" y="74" width="420" height="22" as="geometry"/></mxCell><mxCell id="n4" value="HUẤN LUYỆN NGOẠI TUYẾN THEO CHU KỲ" style="fontFamily=Times New Roman;fontColor=#1F2328;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#5B6068;fontStyle=1;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="-10" y="452" width="420" height="22" as="geometry"/></mxCell><mxCell id="rr" value='&lt;b style="font-size:17px"&gt;Dữ liệu&lt;br&gt;Retail Rocket&lt;/b&gt;' style="fontFamily=Times New Roman;fontColor=#1F2328;rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#1F2328;strokeWidth=1;fillColor=#FFFFFF;spacing=4;fillColor=#F6F7F8;" vertex="1" parent="1"><mxGeometry x="648" y="0" width="164" height="60" as="geometry"/></mxCell><mxCell id="app" value='&lt;b style="font-size:17px"&gt;Ứng dụng&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:14.5px" color="#5B6068"&gt;khách xem, thêm giỏ,&lt;/font&gt;&lt;br&gt;&lt;font style="font-s